# Dependencies
node_modules/
node_modules_broken*/

# Build output
dist/
dist-verify*/
build/

# Environment variables - ignore every real env file (including any future
# variant like .env.production/.env.test), but keep the committed,
# placeholder-only .env.example trackable. The negation MUST come after
# the broader .env.* pattern it un-ignores.
.env
.env.local
.env.*.local
.env.*
!.env.example

# Secrets / credentials - defense in depth. No file matching these exists
# in this project today; this only prevents one from ever being committed
# by accident in the future.
secrets.json
credentials.json
*.pem
*.key
*.p12
*.pfx
# Local/dev TLS certificate directory - security hardening (passwords/
# HTTPS). No certificate authority or production certificate is ever
# committed.
certs/
*.crt

# Vite temp config files
vite.config.js.timestamp-*
vite.config.*.timestamp-*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary, backup, and debug files
*.tmp
*.bak
*.orig
*~
debug*.js
debug*.log
