PORT=5000
# Descriptive placeholders only below - never real credentials (security
# audit - password/secrets). Copy this file to backend/.env and fill in
# your own real, local values there; backend/.env is gitignored and must
# never be committed.
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=1h

# Required ONLY to run `npm run seed:system-admin` (DOC-31) the FIRST time,
# to create the one and only System Admin account. NOT used by the server
# itself (src/server.js never reads these) and NOT required by the seed
# script on a rerun once a System Admin already exists - see
# backend/scripts/seedSystemAdmin.js's own top comment for the exact
# bootstrap-only behavior. Set real values in your local .env only while
# bootstrapping - never commit them.
#
# SYSTEM_ADMIN_PASSWORD is a one-time bootstrap/seed secret: it is only
# ever read server-side by scripts/seedSystemAdmin.js, and only when no
# System Admin exists yet, to hash and store the System Admin's initial
# password. It is never sent to the frontend, never included in any API
# response or JWT, and never logged. In a real deployment this value
# should come from your platform's secret manager (not a committed file).
# Once the System Admin account has been created, this value is no longer
# needed for anything - it is safe to delete it from your local .env (or
# leave it, it is simply ignored from that point on).
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=change_me_before_use
SYSTEM_ADMIN_FULL_NAME=System Administrator

# DOC-45 - optional. Where Request image attachments are stored on disk,
# relative to the backend/ directory. Created automatically if it does not
# exist. Uncomment to override; the default below (uploads/requests)
# already works locally with no changes required.
# UPLOAD_DIR=uploads/requests

# --- S3-compatible object storage for Request images ---
# See backend/README.md's "S3 Image Storage Migration" section for the
# full writeup. Every variable below is optional; leaving all of them
# unset preserves the exact pre-existing GridFS behavior for NEW uploads
# (IMAGE_STORAGE_PROVIDER defaults to "gridfs") - existing GridFS and
# legacy local-disk images always keep working either way, since reads and
# deletes follow each attachment's own stored reference, never this
# setting.

# IMAGE_STORAGE_PROVIDER - which backend NEW Before/Completion Image
# uploads use: "s3" or "gridfs". Defaults to "gridfs" when unset. Set to
# "s3" only once S3_BUCKET/S3_REGION/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY
# below are all filled in.
# IMAGE_STORAGE_PROVIDER=s3

# Required only when IMAGE_STORAGE_PROVIDER=s3.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# S3_ENDPOINT - optional. Set this only when using an S3-compatible
# provider other than real AWS S3 (MinIO, Cloudflare R2, Backblaze B2,
# etc). Leave unset for real AWS S3.
# S3_ENDPOINT=

# --- Security hardening: HTTPS/TLS, CORS, and proxy trust ---
# See backend/README.md's "Security & HTTPS" section for the full
# writeup of local-development vs. production HTTPS architecture. Every
# variable below is optional; leaving all of them unset preserves the
# exact plain-HTTP localhost development behavior this project already
# had, with zero configuration required.

# HTTPS_ENABLED - set to "true" only if you want THIS Express process to
# terminate TLS directly (local HTTPS/LAN testing, or a production
# deployment with no reverse proxy in front). Requires SSL_CERT_PATH and
# SSL_KEY_PATH below. Never commit the certificate/key files themselves -
# *.pem/*.key/*.p12/*.pfx and a conventional certs/ directory are already
# gitignored.
# HTTPS_ENABLED=false
# SSL_CERT_PATH=./certs/localhost.pem
# SSL_KEY_PATH=./certs/localhost-key.pem

# TRUST_PROXY - ONLY set this if the app genuinely runs behind a reverse
# proxy or load balancer that sets X-Forwarded-* headers itself (nginx, a
# cloud platform's edge, etc). Common values: "1" (trust exactly one
# hop), "loopback", or a specific IP/CIDR. Leave unset for local
# development and for any direct-HTTPS deployment with no proxy in
# front - blindly trusting forwarded headers with no real proxy present
# would let a client spoof its own IP/protocol.
# TRUST_PROXY=

# FORCE_HTTPS - set to "true" to redirect plain HTTP requests to HTTPS.
# Only enable this once you have confirmed HTTPS actually works for this
# deployment (either HTTPS_ENABLED=true above, or a TLS-terminating
# reverse proxy with TRUST_PROXY configured correctly) - otherwise this
# can create a redirect loop. Always OFF for local development.
# FORCE_HTTPS=false

# HSTS_ENABLED - set to "true" to send Strict-Transport-Security. HSTS is
# sticky in the browser (it can lock a visitor out of a domain that later
# stops serving HTTPS), so this is never enabled automatically - only
# turn it on once HTTPS is confirmed to work for every visitor.
# HSTS_ENABLED=false

# FRONTEND_ORIGIN - comma-separated allowlist of exact frontend origins
# (scheme + host + port) permitted to call this API (CORS). Defaults to
# this project's own local Vite dev origins if left unset, so local
# development requires no configuration. In production, set this to your
# real deployed frontend's https:// origin(s).
# FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
