node_modules/
node_modules_broken*/

# Environment variables - ignore every real env file, but keep the
# committed, placeholder-only .env.example trackable. The negation MUST
# come after the broader .env.* pattern it un-ignores.
.env
.env.local
.env.*.local
.env.*
!.env.example

# Secrets / credentials - defense in depth. No file matching these exists
# in this project today; this only prevents one from ever being committed
# by accident in the future.
secrets.json
credentials.json
*.pem
*.key
*.p12
*.pfx
# Local/dev TLS certificate directory (SSL_CERT_PATH/SSL_KEY_PATH from
# .env conventionally point here) - security hardening (passwords/HTTPS).
# No certificate authority or production certificate is ever committed;
# a real deployment's TLS material lives in its own secret store, never
# in this repository.
certs/
*.crt

npm-debug.log*
*.log

*.tmp
*.bak
*.orig
*~

# DOC-45 - runtime-uploaded Request images. Metadata lives in MongoDB;
# the actual files are local-disk-only and never committed. .gitkeep
# preserves the directory itself so a fresh clone has somewhere for
# Multer to write to before ever needing UPLOAD_ROOT's own
# fs.mkdirSync(..., { recursive: true }) fallback.
uploads/requests/*
!uploads/requests/.gitkeep
