# Security hardening (passwords/HTTPS) - VITE_API_BASE_URL is PUBLIC
# client configuration (every VITE_-prefixed variable is bundled into the
# browser build and visible to anyone - never put a secret in a VITE_*
# variable). In production this MUST use https:// - an https:// frontend
# calling an http:// API is a mixed-content error the browser will block,
# and (separately) sends every request, including login, unencrypted.
# Local development keeps using plain http://localhost:5000/api below -
# this is expected and safe for same-machine local development.
VITE_API_BASE_URL=http://localhost:5000/api
# Production example (do not uncomment here - set this in your actual
# deployment's environment configuration, never commit a real value):
# VITE_API_BASE_URL=https://api.your-real-domain.com/api

# --- Optional: Vite DEV SERVER HTTPS (LAN testing only) ---
# Deliberately NOT VITE_-prefixed - these configure the Vite dev server
# itself (read in vite.config.js's own Node context), never the browser
# bundle. OFF by default; local development is unaffected unless you set
# DEV_HTTPS_ENABLED=true. Never commit the certificate/key files
# themselves.
# DEV_HTTPS_ENABLED=false
# DEV_SSL_CERT_PATH=./certs/localhost.pem
# DEV_SSL_KEY_PATH=./certs/localhost-key.pem
